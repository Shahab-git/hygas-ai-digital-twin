 "_meta": {
  "purpose": "Sensible enthalpy H(T) - H(298.15 K) of the eight gasifier species by exact integration of NASA 9-coefficient polynomials (python/gasifier_enthalpy.py). Literature data: nothing here is a DOK-ING value.",
  "source": {
   "title": "NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species",
   "authors": "Bonnie J. McBride, Michael J. Zehe, Sanford Gordon",
   "report_number": "NASA/TP-2002-211556 (NAS 1.60:211556; E-13336)",
   "date": "September 2002",
   "ntrs_record": "https://ntrs.nasa.gov/citations/20020085330",
   "pdf": "https://ntrs.nasa.gov/api/citations/20020085330/downloads/20020085330.pdf",
   "retrieved": "2026-11-05",
   "how_transcribed": "The coefficients are the 9 numbers per temperature interval of each species' record in Appendix D, taken verbatim from the text layer of the downloaded PDF by a parser (10 significant digits, Fortran D exponents converted to e); nothing was typed or reconstructed from memory. The PDF text carries a stray carriage return where the source line was wrapped at column 70; it was removed (a digit never moves). Integrity checks: nine numbers per interval, intervals contiguous, the polynomial H(298.15 K) equals the record's own formation enthalpy, the two intervals agree at their joint, and H(T)-H(298.15 K) agrees with NIST-JANAF (tests/test_gasifier_enthalpy.py)."
  },
  "equations": {
   "cp_over_R": "a1*T^-2 + a2*T^-1 + a3 + a4*T + a5*T^2 + a6*T^3 + a7*T^4",
   "h_over_RT": "-a1*T^-2 + a2*ln(T)/T + a3 + a4*T/2 + a5*T^2/3 + a6*T^3/4 + a7*T^4/5 + b1/T",
   "note": "H(T) is the NASA total enthalpy (formation at 298.15 K plus sensible); this module uses only H(T) - H(298.15 K), so the formation value of the record is never used for a balance"
  },
  "R_j_mol_k": 8.31451,
  "R_source": "NASA/TP-2002-211556, list of symbols: universal gas constant 8.314510 J/(mol-K)",
  "reference_temperature_k": 298.15,
  "standard_state_pressure_bar": 1.0,
  "t_min_k": 200.0,
  "t_max_k": 6000.0,
  "status": "Estimated (literature fit); not Confirmed, not DOK-ING data"
 },
